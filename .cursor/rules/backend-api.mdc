description: API and backend integration rules for IIAS Flutter app
globs:

* "lib/**/*api*.dart"
* "lib/**/*service*.dart"
* "lib/**/*repository*.dart"
* "lib/**/*model*.dart"
* "lib/**/*dto*.dart"
alwaysApply: false

